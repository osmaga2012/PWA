@page "/activar/{Token:guid}"
@using System.ComponentModel.DataAnnotations
@using PWA.Interfaces
@layout LoginLayout

@inject IAuthService AuthService

<PageTitle>Restablecer Contrasena - CRM</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <MudIcon Icon="@Icons.Material.Filled.LockReset"
                         Class="login-logo" />
                <MudText Typo="Typo.h4" Class="login-title">
                    Restablecer Contrasena
                </MudText>
                <MudText Typo="Typo.body2" Class="login-subtitle">
                    Indica tu nueva contrasena para acceder de nuevo
                </MudText>
            </div>

            @if (_passwordUpdated)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    Tu contrasena se ha actualizado correctamente.
                </MudAlert>
                <MudButton Href="login"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true">
                    Ir al inicio de sesion
                </MudButton>
            }
            else
            {
                <EditForm Model="@_model" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    <MudTextField @bind-Value="_model.NewPassword"
                                  Label="Nueva contrasena"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Required="true"
                                  RequiredError="La nueva contrasena es obligatoria"
                                  For="@(() => _model.NewPassword)"
                                  Class="mb-4"
                                  Disabled="@_isLoading"
                                  autocomplete="new-password"
                                  OnAdornmentClick="@TogglePasswordVisibility" />

                    <MudTextField @bind-Value="_model.ConfirmPassword"
                                  Label="Confirmar contrasena"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Required="true"
                                  RequiredError="Confirma la nueva contrasena"
                                  For="@(() => _model.ConfirmPassword)"
                                  Class="mb-4"
                                  Disabled="@_isLoading"
                                  autocomplete="new-password" />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error"
                                  Class="mb-4"
                                  Dense="true"
                                  ShowCloseIcon="true"
                                  CloseIconClicked="@(() => _errorMessage = null)">
                            @_errorMessage
                        </MudAlert>
                    }

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Actualizando...</span>
                        }
                        else
                        {
                            <span>Actualizar contrasena</span>
                        }
                    </MudButton>

                    <MudButton Href="login"
                               Variant="Variant.Text"
                               FullWidth="true"
                               Class="mt-2">
                        Volver al inicio de sesion
                    </MudButton>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid Token { get; set; }

    private PasswordResetModel _model = new();
    private bool _isLoading;
    private bool _passwordUpdated;
    private bool _showPassword;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.ConfirmPasswordResetAsync(Token, _model.NewPassword);

            if (result.Success)
            {
                _passwordUpdated = true;
            }
            else
            {
                _errorMessage = result.Message ?? "No se pudo actualizar la contrasena. Solicita un nuevo enlace.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    public class PasswordResetModel
    {
        [Required(ErrorMessage = "La nueva contrasena es obligatoria")]
        [MinLength(6, ErrorMessage = "La contrasena debe tener al menos 6 caracteres")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la nueva contrasena")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contrasenas no coinciden")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
