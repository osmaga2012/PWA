@using PWA.Pages
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                   
                    @if (context.User?.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="mud-container mud-container-maxwidth-lg pa-8">
                            <MudAlert Severity="Severity.Error">
                                <strong>Acceso denegado</strong>
                                <p>No tienes permisos para acceder a esta página.</p>
                            </MudAlert>
                            <MudButton Href="/new/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
                                Volver al inicio
                            </MudButton>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="authorization-loading">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-4">Verificando autenticación...</MudText>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrado</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="mud-container mud-container-maxwidth-lg pa-8">
                    <MudAlert Severity="Severity.Warning">
                        <strong>Página no encontrada</strong>
                        <p>Lo sentimos, no pudimos encontrar la página que buscas.</p>
                    </MudAlert>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
                        Ir al inicio
                    </MudButton>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<style>
    .authorization-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
    }
</style>

