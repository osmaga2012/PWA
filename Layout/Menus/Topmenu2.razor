@using System.Security.Claims
@using CRM.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentUserService CurrentUserService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<MudAppBar Elevation="1" Style="background-color: white; color: #1E293B; height: 70px;" Class="px-3">
    <div class="d-flex align-items-center">
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleClick" />
        </MudHidden>
        <MudIcon Icon="@Icons.Material.Filled.Anchor" Style="color: #0284C7;" Class="ms-2 me-2" />

        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudText Typo="Typo.h6" Class="fw-bold">
                <InfoDatosCofradia />
            </MudText>
        </MudHidden>
    </div>

    <MudSpacer />

    <div class="d-none d-md-block" style="width: 250px;">
        <MudTextField T="string" Placeholder="Buscar..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </div>

    <div class="d-flex align-items-center ms-2">
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudAvatar Style="background-color: #E0F2FE; color: #0369A1; cursor: pointer;">
                    @if (string.IsNullOrWhiteSpace(avatarImage))
                    {
                        @avatarInitials
                    }
                </MudAvatar>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@LogoutAsync">Salir</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</MudAppBar>

@code {

    [Parameter] public bool NavMenuOpen { get; set; }
    [Parameter] public EventCallback OnToggleDrawer { get; set; }

    private UsuarioDto? currentUser;
    private string? avatarImage;
    private string avatarInitials = "";

    private async Task ToggleClick()
    {
        await OnToggleDrawer.InvokeAsync(null);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                currentUser = await CurrentUserService.GetCurrentUserAsync(user);
                if (currentUser != null)
                {
                    //avatarImage = currentUser.FotoPerfil.ToString();
                    if (string.IsNullOrWhiteSpace(avatarImage))
                    {
                        avatarInitials = GetInitials(currentUser, user);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener el usuario actual: {ex.Message}");
        }
    }

    private async Task LogoutAsync()
    {
        try
        {
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cerrar sesión: {ex.Message}");
        }
    }

    private string GetInitials(UsuarioDto? usuario = null, ClaimsPrincipal? principal = null)
    {
        // Preferir datos del DTO si están disponibles
        if (usuario != null)
        {
            var nombre = usuario.Nombre?.Trim();
            var apellidos = usuario.Apellidos?.Trim();
            var nombreUsuario = usuario.NombreUsuario?.Trim();

            if (!string.IsNullOrWhiteSpace(nombre) && !string.IsNullOrWhiteSpace(apellidos))
                return string.Concat(nombre[0], apellidos[0]).ToUpper();

            if (!string.IsNullOrWhiteSpace(nombre))
                return nombre.Substring(0, Math.Min(2, nombre.Length)).ToUpper();

            if (!string.IsNullOrWhiteSpace(nombreUsuario))
                return nombreUsuario.Substring(0, Math.Min(2, nombreUsuario.Length)).ToUpper();
        }

        // Fallback a ClaimsPrincipal
        if (principal != null && principal.Identity?.IsAuthenticated == true)
        {
            var given = principal.FindFirst(ClaimTypes.GivenName)?.Value;
            var family = principal.FindFirst(ClaimTypes.Surname)?.Value;
            var name = principal.FindFirst(ClaimTypes.Name)?.Value;
            var preferred = principal.FindFirst("preferred_username")?.Value;

            if (!string.IsNullOrWhiteSpace(given) && !string.IsNullOrWhiteSpace(family))
                return string.Concat(given.Trim()[0], family.Trim()[0]).ToUpper();

            if (!string.IsNullOrWhiteSpace(name))
            {
                var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length >= 2)
                    return string.Concat(parts[0][0], parts[1][0]).ToUpper();
                return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
            }

            if (!string.IsNullOrWhiteSpace(preferred))
                return preferred.Substring(0, Math.Min(2, preferred.Length)).ToUpper();
        }

        return "";
    }


}
